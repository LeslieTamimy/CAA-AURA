  ];

  const MONTHS = ['Janvier', 'Février', 'Mars', 'Avril', 'Mai', 'Juin', 'Juillet', 'Août', 'Septembre', 'Octobre', 'Novembre', 'Décembre'];
  let today = new Date();
  let currentMonth = today.getFullYear() === 2026 ? today.getMonth() : null;
  let selectedMonth = currentMonth === null ? 0 : currentMonth;
  let expandedDay = '';
  let opener = null;
  const els = {
    title: root.querySelector('#caa-agenda-month-title'),
    prev: root.querySelector('#caa-agenda-prev'), next: root.querySelector('#caa-agenda-next'),
    today: root.querySelector('#caa-agenda-today'), grid: root.querySelector('#caa-agenda-grid'),
    mobile: root.querySelector('#caa-agenda-mobile-list'), upcoming: root.querySelector('#caa-agenda-upcoming-list'),
    status: root.querySelector('#caa-agenda-status'), overlay: root.querySelector('#caa-agenda-modal'),
    dialog: root.querySelector('.caa-agenda__dialog-shell'), close: root.querySelector('#caa-agenda-close'),
    dialogTitle: root.querySelector('#caa-agenda-dialog-title'), details: root.querySelector('#caa-agenda-dialog-details'),
    description: root.querySelector('#caa-agenda-dialog-description'), actions: root.querySelector('#caa-agenda-dialog-actions')
  };

  /* Dates en UTC pour éviter les décalages liés aux fuseaux horaires. */
  function parseDate(value) {
    if (!/^2026-\d{2}-\d{2}$/.test(value || '')) return null;
    const date = new Date(value + 'T12:00:00Z');
    return Number.isNaN(date.getTime()) || date.toISOString().slice(0, 10) !== value ? null : date;
  }
  function iso(date) { return date.toISOString().slice(0, 10); }
  function dateText(value, options) { return new Intl.DateTimeFormat('fr-FR', Object.assign({ timeZone: 'UTC' }, options)).format(parseDate(value)); }
  function dateRange(event) {
    const start = dateText(event.startDate, { day: 'numeric', month: 'long', year: 'numeric' });
    return event.endDate && event.endDate !== event.startDate
      ? 'Du ' + start + ' au ' + dateText(event.endDate, { day: 'numeric', month: 'long', year: 'numeric' })
      : dateText(event.startDate, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
  }
  function timeText(event) {
    if (event.startTime && event.endTime) return event.startTime + ' – ' + event.endTime;
    if (event.startTime) return 'À partir de ' + event.startTime;
    if (event.endTime) return 'Jusqu’à ' + event.endTime;
    return '';
  }
  function locationText(event) { return event.format === 'Distanciel' ? 'En ligne' : event.venue || ''; }
  function validUrl(value) {
    try { const url = new URL(value); return /^https?:$/.test(url.protocol) ? url.href : ''; }
    catch (_) { return ''; }
  }

  const sortedEvents = events.filter(function (event) {
    const start = parseDate(event.startDate);
    const end = parseDate(event.endDate || event.startDate);
    return event.id && event.title && start && end && end >= start;
  }).sort(function (a, b) {
    return a.startDate.localeCompare(b.startDate) || (a.startTime || '').localeCompare(b.startTime || '');
  });
  const byId = new Map(sortedEvents.map(function (event) { return [event.id, event]; }));
  const monthEvents = function () {
    const first = iso(new Date(Date.UTC(2026, selectedMonth, 1, 12)));
    const last = iso(new Date(Date.UTC(2026, selectedMonth + 1, 0, 12)));
    return sortedEvents.filter(function (event) {
      return event.startDate <= last && (event.endDate || event.startDate) >= first;
    });
  };

  /* Affichage : boutons créés par DOM, textes injectés avec textContent. */
  function makeEventButton(event, variant) {
    const button = document.createElement('button');
    button.type = 'button';
    button.dataset.eventId = event.id;
    button.className = variant === 'calendar' ? 'caa-agenda__event' : 'caa-agenda__list-item';
    button.setAttribute('aria-label', event.title + ', ' + dateRange(event) + ', ' + (event.category || 'Autre événement'));
    if (variant === 'calendar') {
      const title = document.createElement('span'); title.className = 'caa-agenda__event-title'; title.textContent = event.shortTitle || event.title;
      button.append(title);
    } else {
      const date = document.createElement('span'); date.className = 'caa-agenda__list-date'; date.textContent = [dateRange(event), timeText(event)].filter(Boolean).join(' · ');
      const type = document.createElement('span'); type.className = 'caa-agenda__list-type'; type.textContent = event.category || 'Autre événement';
      const title = document.createElement('span'); title.className = 'caa-agenda__list-title'; title.textContent = event.title;
      button.append(date, type, title);
      const place = locationText(event);
      if (place) { const meta = document.createElement('span'); meta.className = 'caa-agenda__list-meta'; meta.textContent = place; button.append(meta); }
    }
    return button;
  }
  function emptyMessage(text) { const p = document.createElement('p'); p.className = 'caa-agenda__empty'; p.textContent = text; return p; }
  function renderCalendar(visible) {
    els.grid.replaceChildren();
    const firstDay = new Date(Date.UTC(2026, selectedMonth, 1, 12));
    const leading = (firstDay.getUTCDay() + 6) % 7;
    const days = new Date(Date.UTC(2026, selectedMonth + 1, 0, 12)).getUTCDate();
    const total = Math.ceil((leading + days) / 7) * 7;
    const fragment = document.createDocumentFragment();
    for (let cell = 0; cell < total; cell++) {
      const number = cell - leading + 1;
      const day = document.createElement('div');
      day.className = 'caa-agenda__day';
      if (number < 1 || number > days) { day.classList.add('caa-agenda__day--outside'); fragment.append(day); continue; }
      const key = iso(new Date(Date.UTC(2026, selectedMonth, number, 12)));
      if (today.getFullYear() === 2026 && today.getMonth() === selectedMonth && today.getDate() === number) day.classList.add('caa-agenda__day--today');
      const date = document.createElement('p'); date.className = 'caa-agenda__date'; date.textContent = String(number);
      if (day.classList.contains('caa-agenda__day--today')) {
        const screenReaderLabel = document.createElement('span');
        screenReaderLabel.className = 'caa-agenda__sr-only';
        screenReaderLabel.textContent = ' — aujourd’hui';
        date.append(screenReaderLabel);
      }
      day.append(date);
      const matches = visible.filter(function (event) { return event.startDate <= key && (event.endDate || event.startDate) >= key; });
      if (matches.length) day.classList.add('caa-agenda__day--has-event');
      const limit = expandedDay === key ? matches.length : 2;
      matches.slice(0, limit).forEach(function (event) { day.append(makeEventButton(event, 'calendar')); });
      if (matches.length > 2) {
        const more = document.createElement('button'); more.type = 'button'; more.className = 'caa-agenda__more-day';
        more.dataset.expandDay = key;
        more.textContent = expandedDay === key ? 'Voir moins' : '+' + (matches.length - 2) + ' autres événements';
        more.setAttribute('aria-expanded', String(expandedDay === key));
        more.setAttribute('aria-label', (expandedDay === key ? 'Voir moins d’événements' : 'Afficher ' + (matches.length - 2) + ' autres événements') + ' le ' + number + ' ' + MONTHS[selectedMonth].toLowerCase());
        day.append(more);
      }
      fragment.append(day);
    }
    els.grid.append(fragment);
  }
  function renderList(target, list, emptyText) {
    target.replaceChildren();
    if (!list.length) { target.append(emptyMessage(emptyText)); return; }
    const fragment = document.createDocumentFragment();
    list.forEach(function (event) { fragment.append(makeEventButton(event, 'list')); });
    target.append(fragment);
  }
  function render() {
    const visible = monthEvents();
    els.title.textContent = MONTHS[selectedMonth] + ' 2026';
    els.prev.disabled = selectedMonth === 0;
    els.next.disabled = selectedMonth === 11;
    els.today.hidden = currentMonth === null || selectedMonth === currentMonth;
    renderCalendar(visible);
    renderList(els.mobile, visible, 'Aucun événement pour ce mois.');
    const todayKey = today.getFullYear() === 2026 ? [2026, String(today.getMonth() + 1).padStart(2, '0'), String(today.getDate()).padStart(2, '0')].join('-') : (today.getFullYear() < 2026 ? '2026-01-01' : '2027-01-01');
    const upcoming = sortedEvents.filter(function (event) { return (event.endDate || event.startDate) >= todayKey; }).slice(0, 3);
    renderList(els.upcoming, upcoming, 'Aucun prochain événement.');
    els.status.textContent = MONTHS[selectedMonth] + ' 2026 : ' + visible.length + ' événement' + (visible.length > 1 ? 's' : '') + ' affiché' + (visible.length > 1 ? 's' : '') + '.';
  }

  /* Navigation entre les 12 mois. */
  els.prev.addEventListener('click', function () { if (selectedMonth > 0) { selectedMonth--; expandedDay = ''; render(); } });
  els.next.addEventListener('click', function () { if (selectedMonth < 11) { selectedMonth++; expandedDay = ''; render(); } });
  els.today.addEventListener('click', function () { if (currentMonth !== null) { selectedMonth = currentMonth; expandedDay = ''; render(); } });

  /* Modale : seules les données présentes produisent une ligne. */
  function addDetail(label, value) {
    if (!value) return;
    const dt = document.createElement('dt'); dt.textContent = label;
    const dd = document.createElement('dd'); dd.textContent = value;
    els.details.append(dt, dd);
  }
  function addAction(label, url, className) {
    const safe = validUrl(url);
    if (!safe) return;
    const link = document.createElement('a'); link.href = safe; link.target = '_blank'; link.rel = 'noopener noreferrer';
    link.className = className; link.textContent = label;
    link.setAttribute('aria-label', label + ' (nouvel onglet)');
    els.actions.append(link);
  }
  function openModal(event, trigger) {
    opener = trigger;
    els.dialogTitle.textContent = event.title;
    els.details.replaceChildren();
    addDetail(timeText(event) ? 'Date et horaires' : 'Date', [dateRange(event), timeText(event)].filter(Boolean).join(' · '));
    addDetail('Type d’événement', event.category);
    addDetail('Organisateur', event.organizer);
    addDetail('Lieu', event.format === 'Distanciel' ? 'En ligne' : event.venue);
    addDetail('Adresse', event.address);
    els.description.textContent = event.description || '';
    els.actions.replaceChildren();
    addAction('S’inscrire à l’événement', event.registrationUrl, 'caa-agenda__cta');
    addAction(event.moreInfoLabel || 'En savoir plus', event.moreInfoUrl, 'caa-agenda__secondary');
    /* Un lien utile reste disponible même pour un futur événement sans URL publiée. */
    if (!els.actions.children.length) addAction('Consulter le site CAA AuRA', 'https://caa-aura.fr/', 'caa-agenda__secondary');
    els.overlay.hidden = false;
    els.close.focus();
  }
  function closeModal() {
    if (els.overlay.hidden) return;
    els.overlay.hidden = true;
    if (opener && opener.isConnected) opener.focus();
    opener = null;
  }
  root.addEventListener('click', function (event) {
    const eventButton = event.target.closest('[data-event-id]');
    if (eventButton && root.contains(eventButton)) { const item = byId.get(eventButton.dataset.eventId); if (item) openModal(item, eventButton); return; }
    const more = event.target.closest('[data-expand-day]');
    if (more && root.contains(more)) {
      const key = more.dataset.expandDay;
      expandedDay = expandedDay === key ? '' : key;
      renderCalendar(monthEvents());
      const replacement = Array.from(els.grid.querySelectorAll('[data-expand-day]')).find(function (button) { return button.dataset.expandDay === key; });
      if (replacement) replacement.focus();
    }
  });
  els.close.addEventListener('click', closeModal);
  els.overlay.addEventListener('click', function (event) { if (event.target === els.overlay) closeModal(); });

  /* Clavier : Échap, boucle Tab et retour au bouton déclencheur. */
  document.addEventListener('keydown', function (event) {
    if (els.overlay.hidden) return;
    if (event.key === 'Escape') { event.preventDefault(); closeModal(); return; }
    if (event.key !== 'Tab') return;
    const focusables = Array.from(els.dialog.querySelectorAll('button:not([disabled]), a[href], [tabindex]:not([tabindex="-1"])')).filter(function (node) { return !node.hidden; });
    if (!focusables.length) { event.preventDefault(); els.dialog.focus(); return; }
    const first = focusables[0], last = focusables[focusables.length - 1];
    if (event.shiftKey && (document.activeElement === first || !els.dialog.contains(document.activeElement))) { event.preventDefault(); last.focus(); }
    else if (!event.shiftKey && (document.activeElement === last || !els.dialog.contains(document.activeElement))) { event.preventDefault(); first.focus(); }
  });
  document.addEventListener('focusin', function (event) { if (!els.overlay.hidden && !els.dialog.contains(event.target)) els.close.focus(); });

  /* Actualise le repère du jour et la liste « À venir » après minuit,
     même si la page reste ouverte. Une reprise d’onglet force aussi la vérification. */
  let dailyRefreshTimer;
  function refreshCurrentDay() {
    const now = new Date();
    const hasChanged = now.getFullYear() !== today.getFullYear()
      || now.getMonth() !== today.getMonth() || now.getDate() !== today.getDate();
    today = now;
    currentMonth = now.getFullYear() === 2026 ? now.getMonth() : null;
    if (hasChanged) render();
    scheduleDailyRefresh();
  }
  function scheduleDailyRefresh() {
    clearTimeout(dailyRefreshTimer);
    const now = new Date();
    const nextDay = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1, 0, 0, 1);
    dailyRefreshTimer = setTimeout(refreshCurrentDay, nextDay.getTime() - now.getTime());
  }
  document.addEventListener('visibilitychange', function () {
    if (document.visibilityState === 'visible') refreshCurrentDay();
  });
  render();
  scheduleDailyRefresh();
})();
</script>
