    {
      id: 'caa-2026-12-11-ari', title: 'Conférence d’Albert Moukheiber – 40 ans de l’ARI', shortTitle: 'Conférence Albert Moukheiber',
      startDate: '2026-12-11', endDate: '2026-12-11', startTime: '', endTime: '', duration: '',
      venue: 'Marseille', address: '', city: 'Marseille', format: 'Présentiel', category: 'Conférence', organizer: 'ARI – Association Régionale pour l’Intégration',
      description: 'À l’occasion de ses 40 ans, l’ARI organise une année de rencontres autour de la communication et de la CAA. Cette conférence d’Albert Moukheiber, docteur en neurosciences et psychologue clinicien, clôture la programmation et prolonge la réflexion sur l’autonomie, l’autodétermination, la participation et le pouvoir d’agir des personnes accompagnées.',
      registrationUrl: '', moreInfoUrl: 'https://www.ari.asso.fr/actualites/dernieres-actualites/en-2026-lari-fete-ses-40-ans-'
